{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://opendpi.org/schema/1.0.0/tag",
    "title": "OpenDPI Tag",
    "description": "A tag for categorizing ports.",
    "type": "object",
    "required": [
        "name"
    ],
    "properties": {
        "name": {
            "type": "string",
            "description": "The name of the tag."
        },
        "description": {
            "type": "string",
            "description": "A description of what this tag represents."
        }
    }
}
